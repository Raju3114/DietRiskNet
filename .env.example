# --- Database ---
# Default to SQLite locally, but use PostgreSQL for Docker Compose
DATABASE_URL=sqlite:///./dietrisknet.db
# PostgreSQL for Docker Compose:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/dietrisknet

# --- FastAPI Configuration ---
# IMPORTANT: Generate a strong random key for production.
# You can use: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME___insecure_dev_jwt_key___DO_NOT_USE_IN_PRODUCTION

# MODELS_DIR and NUTRITION_CSV_PATH are intentionally left unset.
# The application resolves them to PROJECT-RELATIVE paths automatically,
# so the project works from any folder/drive (important for portability).
# Only set them here if you need to override:
# MODELS_DIR=
# NUTRITION_CSV_PATH=

# Food classifier: EfficientNet-B3 by default (EfficientNet-B0 is the fallback).
# FOOD_CLASSIFIER_MODEL=DietRiskNet_FoodClassifier_EfficientNetB3.pth

# --- LLM Provider (AI Dietitian / meal chat / Nutrition Assistant) ---
# Provider options:
#   "ollama" (DEFAULT) — local Ollama server; no API key required.
#   "gemini" (OPTIONAL) — Google Gemini cloud; requires GEMINI_API_KEY.
# When "gemini" is selected and Gemini fails, requests automatically
# fall back to a local Ollama instance.
LLM_PROVIDER=ollama

# --- Ollama (default local provider) ---
# URL of the local Ollama server.
OLLAMA_URL=http://localhost:11434
# Model to use (must be pulled first: `ollama pull llama3.2:3b`).
OLLAMA_MODEL=llama3.2:3b
# Request timeout in seconds.
OLLAMA_TIMEOUT=120

# --- Gemini (optional cloud provider) ---
# Set your Google Gemini API key here (replace YOUR_GEMINI_API_KEY_HERE).
# Gemini is OPTIONAL — the application works fully with Ollama and no
# API key. Leave empty to keep Gemini disabled.
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Gemini model to use. Override if you prefer a different tier.
GEMINI_MODEL=gemini-2.0-flash

# Request timeout in seconds.
GEMINI_TIMEOUT=15

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
